name: Validate control tower
on: [push, pull_request]
jobs:
  fixture-and-postgres:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16.6
        env:
          POSTGRES_USER: tower_test
          POSTGRES_PASSWORD: local_ci_only
          POSTGRES_DB: control_tower
        ports: ["5432:5432"]
        options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
      - run: python -m pip install -r requirements.txt
      - run: python src/run_pipeline.py --mode sample --fixture
      - run: python -m pytest -q
        env:
          TEST_DATABASE_URL: postgresql+psycopg://tower_test:local_ci_only@localhost:5432/control_tower
